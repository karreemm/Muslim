# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git and must never be committed.

# ── Supabase ────────────────────────────────────────────────────────────────
# Used by the Sadaqa Jariyah route handlers and the keep-alive script.
# The service-role key is server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SADAQA_TABLE=sadaqa_garya_records

# ── Hadith API ──────────────────────────────────────────────────────────────
# Get a key from https://hadithapi.com/
HADITH_API_KEY=your-hadith-api-key
HADITH_API_BASE_URL=https://hadithapi.com/api


# Public site URL used for canonical links, sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://muslim-one.vercel.app
